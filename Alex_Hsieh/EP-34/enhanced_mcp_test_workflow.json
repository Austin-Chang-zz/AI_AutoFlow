{
  "name": "Enhanced n8n MCP Test Workflow",
  "nodes": [
    {
      "parameters": {
        "path": "mcp-test",
        "responseMode": "lastNode",
        "responseData": "allEntries",
        "options": {
          "noResponseBody": false
        }
      },
      "id": "webhook-trigger",
      "name": "MCP Test Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300],
      "webhookId": "mcp-test-webhook-001"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "1",
              "name": "requestId",
              "value": "={{ $now.toUnixInteger() }}-{{ Math.random().toString(36).substr(2, 9) }}",
              "type": "string"
            },
            {
              "id": "2",
              "name": "timestamp",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            },
            {
              "id": "3",
              "name": "receivedData",
              "value": "={{ $json }}",
              "type": "object"
            },
            {
              "id": "4",
              "name": "httpMethod",
              "value": "={{ $httpMethod }}",
              "type": "string"
            },
            {
              "id": "5",
              "name": "headers",
              "value": "={{ $headers }}",
              "type": "object"
            },
            {
              "id": "6",
              "name": "queryParams",
              "value": "={{ $query }}",
              "type": "object"
            }
          ]
        },
        "options": {}
      },
      "id": "extract-request-data",
      "name": "提取請求數據",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [400, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "1",
              "leftValue": "={{ $json.httpMethod }}",
              "rightValue": "POST",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-method",
      "name": "檢查HTTP方法",
      "type": "n8n-nodes-base.if",
      "position": [600, 300],
      "typeVersion": 2
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "1",
              "name": "status",
              "value": "success",
              "type": "string"
            },
            {
              "id": "2",
              "name": "message",
              "value": "MCP Test successful! Data processed correctly.",
              "type": "string"
            },
            {
              "id": "3",
              "name": "processedAt",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            },
            {
              "id": "4",
              "name": "mcpVersion",
              "value": "2.7.15",
              "type": "string"
            },
            {
              "id": "5",
              "name": "testResults",
              "value": "={\n  \"requestId\": \"{{ $json.requestId }}\",\n  \"dataReceived\": {{ $json.receivedData ? 'true' : 'false' }},\n  \"timestampValid\": {{ $json.timestamp ? 'true' : 'false' }},\n  \"methodCorrect\": {{ $json.httpMethod === 'POST' ? 'true' : 'false' }},\n  \"processingTime\": \"{{ $now.diff($json.timestamp, 'milliseconds') }}ms\"\n}",
              "type": "object"
            },
            {
              "id": "6",
              "name": "responseData",
              "value": "={\n  \"success\": true,\n  \"requestId\": \"{{ $json.requestId }}\",\n  \"timestamp\": \"{{ $json.timestamp }}\",\n  \"processedAt\": \"{{ $now.toISO() }}\",\n  \"method\": \"{{ $json.httpMethod }}\",\n  \"receivedData\": {{ JSON.stringify($json.receivedData) }},\n  \"testResults\": {{ JSON.stringify($json.testResults) }},\n  \"mcpInfo\": {\n    \"version\": \"2.7.15\",\n    \"server\": \"n8n-mcp\",\n    \"testType\": \"webhook-processing\"\n  }\n}",
              "type": "object"
            }
          ]
        },
        "options": {}
      },
      "id": "process-post-data",
      "name": "處理POST數據",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [800, 200]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "1",
              "name": "status",
              "value": "error",
              "type": "string"
            },
            {
              "id": "2",
              "name": "message",
              "value": "=Invalid HTTP method: {{ $json.httpMethod }}. Only POST requests are supported for this test.",
              "type": "string"
            },
            {
              "id": "3",
              "name": "processedAt",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            },
            {
              "id": "4",
              "name": "responseData",
              "value": "={\n  \"success\": false,\n  \"error\": \"Method not allowed\",\n  \"requestId\": \"{{ $json.requestId }}\",\n  \"timestamp\": \"{{ $json.timestamp }}\",\n  \"method\": \"{{ $json.httpMethod }}\",\n  \"allowedMethods\": [\"POST\"],\n  \"mcpInfo\": {\n    \"version\": \"2.7.15\",\n    \"server\": \"n8n-mcp\",\n    \"testType\": \"webhook-processing\"\n  }\n}",
              "type": "object"
            }
          ]
        },
        "options": {}
      },
      "id": "handle-invalid-method",
      "name": "處理無效方法",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [800, 400]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "1",
              "name": "finalResponse",
              "value": "={{ $json.responseData }}",
              "type": "object"
            },
            {
              "id": "2",
              "name": "httpStatusCode",
              "value": "={{ $json.status === 'success' ? 200 : 400 }}",
              "type": "number"
            },
            {
              "id": "3",
              "name": "contentType",
              "value": "application/json",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "prepare-response",
      "name": "準備最終回應",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1000, 300]
    }
  ],
  "pinData": {},
  "connections": {
    "MCP Test Webhook": {
      "main": [
        [
          {
            "node": "提取請求數據",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "提取請求數據": {
      "main": [
        [
          {
            "node": "檢查HTTP方法",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "檢查HTTP方法": {
      "main": [
        [
          {
            "node": "處理POST數據",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "處理無效方法",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "處理POST數據": {
      "main": [
        [
          {
            "node": "準備最終回應",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "處理無效方法": {
      "main": [
        [
          {
            "node": "準備最終回應",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "any",
    "errorWorkflow": "",
    "timezone": "UTC"
  },
  "versionId": "enhanced-mcp-test-v1.0.0",
  "meta": {
    "templateCredsSetupCompleted": true,
    "instanceId": "enhanced-mcp-test-instance"
  },
  "id": "enhanced-mcp-test-workflow",
  "tags": ["MCP", "Test", "Webhook", "API"],
  "description": "Enhanced MCP test workflow with comprehensive request processing, validation, and detailed response formatting"
}
